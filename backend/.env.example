# Server
PORT=5000
NODE_ENV=development

# Supabase — ใช้ "Session pooler" จาก Dashboard (ไม่ใช่ Direct db.xxx)
# Project Settings > Database > Connection string > Session pooler > URI
# ตัวอย่าง (เปลี่ยน PASSWORD และ REGION ให้ตรงกับโปรเจกต์):
# DATABASE_URL="postgresql://postgres.pfwxcvzgblygnwvmgxlt:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
#
# สำคัญ:
# - อย่าใส่ [ ] รอบรหัสผ่าน
# - ถ้ารหัสมีอักขระพิเศษ ให้ URL-encode (เช่น @ → %40)
# - Windows มักเชื่อม Direct (db.xxx.supabase.co:5432) ไม่ได้ → ต้องใช้ pooler
# ⚡ OPTIMIZATION TIP (สำหรับผู้ใช้เยอะๆ): เปลี่ยน port เป็น 6543 (Transaction pooler) และเติม ?pgbouncer=true&connection_limit=1 ต่อท้าย

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Discord Webhook & OAuth2
DISCORD_WEBHOOK_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
FRONTEND_URL=

# Seed admin account
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
